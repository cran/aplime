Package: aplime
Type: Package
Title: Adaptive Piecewise Local Model-Agnostic Explanations
Version: 0.1.0
Authors@R: c(
    person("Abdullah Nuri", "Somuncuoğlu",
           email = "abdullah.somuncuoglu@metu.edu.tr",
           role = c("aut"),
           comment = c(affiliation = "Department of Biomedical Engineering, Middle East Technical University")),
    person("Vilda", "Purutçuoğlu",
